---
// src/layouts/Layout.astro
import background from '../assets/background.svg';
import NavTabs from '../components/NavTabs.astro';

interface Props {
  title?: string;
}

const { title = "My Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Inline styles guarantee it stays pinned in the background and blurred -->
    <img 
      src={background.src} 
      alt="" 
      fetchpriority="high"
      style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; 
	  z-index: 0; filter: blur(100px); object-fit: cover; pointer-events: none;" 
    />

    <div class="content-wrapper">
      <header>
        <NavTabs />
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
    background-color: #0b0f19;
    color: #e2e8f0;
    font-family: Inter, Roboto, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .content-wrapper {
    width: 860px; 
    max-width: calc(100% - 2rem); 
    margin: 2.5rem auto; 
    background-color: #0e1526; 
    padding: 2rem 2.5rem;
    border-radius: 12px;
    box-sizing: border-box;
    z-index: 1;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0.5rem 0 1rem 0;
  }

  p {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
</style>