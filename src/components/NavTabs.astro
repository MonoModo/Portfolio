---
// src/components/NavTabs.astro
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL; // Returns "/Portfolio/" in production

// Define your pages/tabs here
const tabs = [
  { name: "Resume", path: "/resume" },
  { name: "Papers", path: "/papers" },
  { name: "C++ Projects", path: "/cppProjects" },
  { name: "Shader Viewer", path: "/shaders" },
];
---
