</nav> -->

<nav class="tabs-container">
  {tabs.map((tab) => {
    // Ensures URLs are always "/Portfolio/resume", "/Portfolio/papers", etc.
    const href = `${base}${tab.path}`;
    const isActive = tab.path === "" 
      ? (currentPath === base || currentPath === `${base}/`)
      : currentPath.includes(tab.path);

    return (
      <a href={href} class:list={["tab", { active: isActive }]}>
        {tab.name}
      </a>
    );
  })}
</nav>

<style>
  .tabs-container {
    display: flex;
    gap: 12px;
    border-bottom: 2px solid #2d3748;
    margin-bottom: 2rem;
    padding-bottom: 0;
  }

  .tab {
    padding: 10px 18px;
    text-decoration: none;
    font-weight: 500;
    color: #94a3b8;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px; /* Overlaps container bottom border */
    transition: all 0.2s ease;
    border-radius: 6px 6px 0 0;
  }

  .tab:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.05);
  }

  .tab.active {
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
    font-weight: 600;
  }
</style>