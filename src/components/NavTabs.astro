---
// src/components/NavTabs.astro
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL; // Returns "/Portfolio/" in production

// Define your pages/tabs here
const tabs = [
//   { name: "Home", href: "${base}" },
  { name: "Resume", href: `${base}/resume` },
  { name: "Papers", href: `${base}/papers` },
  { name: "Computational projects", href: `${base}/cppProjects` },
  { name: "Shaders", href: `${base}/shaders` },
];
---

<nav class="tabs-container">
  {tabs.map((tab) => {
    // Check if the current page matches this tab's link
    const isActive =
      tab.href === "/" 
        ? currentPath === "/" 
        : currentPath.startsWith(tab.href);

    return (
      <a
        href={tab.href}
        class:list={["tab", { active: isActive }]}
      >
        {tab.name}
      </a>
    );
  })}
</nav>

<style>
  .tabs-container {
    display: flex;
    gap: 12px;
    border-bottom: 2px solid #2d3748;
    margin-bottom: 2rem;
    padding-bottom: 0;
  }

  .tab {
    padding: 10px 18px;
    text-decoration: none;
    font-weight: 500;
    color: #94a3b8;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px; /* Overlaps container bottom border */
    transition: all 0.2s ease;
    border-radius: 6px 6px 0 0;
  }

  .tab:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.05);
  }

  .tab.active {
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
    font-weight: 600;
  }
</style>